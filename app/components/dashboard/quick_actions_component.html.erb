<%= render Shadcn::CardComponent.new(class: "h-full") do |card| %>
  <% card.with_header do %>
    <% card.with_title { "Quick Actions" } %>
    <% card.with_description { "Common product operations" } %>
  <% end %>
  <% card.with_content do %>
    <div class="flex flex-col gap-2">
      <% actions.each do |action| %>
        <%= link_to action[:label], action[:path],
            class: button_classes(action[:variant] || :outline) %>
      <% end %>
    </div>
  <% end %>
<% end %>
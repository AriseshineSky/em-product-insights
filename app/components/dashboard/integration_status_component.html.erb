<%= render Shadcn::CardComponent.new do |card| %>
  <% card.with_header do %>
    <% card.with_title { "Integrations" } %>
    <% card.with_description { "API connection status" } %>
  <% end %>
  <% card.with_content do %>
    <div class="space-y-3">
      <% integrations.each do |integration| %>
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full <%= integration[:configured] ? 'bg-green-500' : 'bg-gray-400' %>"></span>
            <span class="text-sm font-medium"><%= integration[:name] %></span>
          </div>
          <%= render Shadcn::BadgeComponent.new(variant: integration[:configured] ? :default : :secondary) do %>
            <%= integration[:configured] ? "Active" : "Not Configured" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
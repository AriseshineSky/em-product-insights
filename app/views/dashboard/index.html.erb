<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">Product Insights</h1>
      <p class="text-muted-foreground">Monitor merchant product status, BigQuery issues, and integration health.</p>
    </div>
    <div class="text-sm text-muted-foreground">
      <%= Date.today.strftime("%B %d, %Y") %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
    <%= render Dashboard::MetricCardComponent.new(
      title: "Cyp Products",
      description: "Total sourced",
      value: number_with_delimiter(@cyp_count)
    ) %>

    <%= render Dashboard::MetricCardComponent.new(
      title: "Checked",
      description: "Status checks",
      value: number_with_delimiter(@total_checked)
    ) %>

    <%= render Dashboard::MetricCardComponent.new(
      title: "Not Found",
      description: "Missing from Merchant",
      value: number_with_delimiter(@merchant_stats.fetch("not_found", 0))
    ) %>

    <%= render Dashboard::MetricCardComponent.new(
      title: "Last Check",
      description: "Most recent run",
      value: @last_checked ? @last_checked.strftime("%H:%M") : "Never"
    ) %>
  </div>

  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    <%= render Dashboard::MerchantStatusComponent.new(
      stats: @merchant_stats,
      total: @total_checked
    ) %>

    <%= render Dashboard::IntegrationStatusComponent.new(
      integrations: Dashboard::IntegrationStatusComponent.default_integrations
    ) %>

    <%= render Dashboard::QuickActionsComponent.new(
      actions: Dashboard::QuickActionsComponent.default_actions
    ) %>
  </div>
</div>
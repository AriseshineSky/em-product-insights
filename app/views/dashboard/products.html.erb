<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">Merchant Product Status</h1>
      <p class="text-muted-foreground">Cyp source products checked against Google Merchant.</p>
    </div>
    <%= link_to "Back to Dashboard", root_path, class: "inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2" %>
  </div>

  <%= render Shadcn::CardComponent.new do |card| %>
    <% card.with_header do %>
      <% card.with_title { "Products (#{number_with_delimiter(@products.count)} showing)" } %>
    <% end %>
    <% card.with_content do %>
      <%= render Shadcn::TableComponent.new do |table| %>
        <% table.with_header do |header| %>
          <% header.with_row do |row| %>
            <% row.with_head { "Product ID" } %>
            <% row.with_head { "Offer ID" } %>
            <% row.with_head { "Handle" } %>
            <% row.with_head { "State" } %>
            <% row.with_head { "Availability" } %>
            <% row.with_head { "Checked" } %>
          <% end %>
        <% end %>
        <% table.with_body do |body| %>
          <% @products.each do |product| %>
            <% body.with_row do |row| %>
              <% row.with_cell { product.product_id.to_s } %>
              <% row.with_cell { product.offer_id.to_s } %>
              <% row.with_cell { product.handle.to_s } %>
              <% row.with_cell do %>
                <%= case product.state
                    when "found"
                      render Shadcn::BadgeComponent.new(variant: :default) { "Found" }
                    when "not_found"
                      render Shadcn::BadgeComponent.new(variant: :destructive) { "Not Found" }
                    when "error"
                      render Shadcn::BadgeComponent.new(variant: :secondary) { "Error" }
                    end %>
              <% end %>
              <% row.with_cell { product.availability.to_s } %>
              <% row.with_cell { product.checked_at&.strftime("%b %d %H:%M") } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
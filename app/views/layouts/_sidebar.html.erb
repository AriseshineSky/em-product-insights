<aside class="fixed inset-y-0 left-0 z-30 hidden w-64 flex-col border-r border-border bg-sidebar text-sidebar-foreground lg:flex">
  <div class="flex h-16 items-center gap-2 border-b border-sidebar-border px-6">
    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z" /><path d="M12 12v9" /><path d="M3 7.5 12 12l9-4.5" />
      </svg>
    </span>
    <span class="text-sm font-semibold tracking-tight">Em Product Insights</span>
  </div>

  <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-4">
    <%= link_to root_path, class: (current_page?(root_path) ? nav_active : nav_default) do %>
      <%= sidebar_icon(:grid) %> Dashboard
    <% end %>

    <%= link_to products_path, class: (current_page?(products_path) ? nav_active : nav_default) do %>
      <%= sidebar_icon(:package) %> Products
    <% end %>

    <div class="px-3 pt-6 pb-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">Integrations</div>
    <%= content_tag(:button, type: "button", disabled: true, class: nav_inactive) do %>
      <%= sidebar_icon(:activity) %> Google Merchant
    <% end %>
    <%= content_tag(:button, type: "button", disabled: true, class: nav_inactive) do %>
      <%= sidebar_icon(:database) %> BigQuery
    <% end %>
    <%= content_tag(:button, type: "button", disabled: true, class: nav_inactive) do %>
      <%= sidebar_icon(:refresh) %> Spree API
    <% end %>
  </nav>

  <div class="border-t border-sidebar-border p-4">
    <div class="flex items-center gap-3">
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-sidebar-accent text-sidebar-accent-foreground text-xs font-semibold">EM</span>
      <div class="min-w-0">
        <p class="truncate text-sm font-medium">Product Insights</p>
        <p class="truncate text-xs text-muted-foreground"><%= Rails.env %></p>
      </div>
    </div>
  </div>
</aside>